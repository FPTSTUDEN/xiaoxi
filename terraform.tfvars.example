# Replace these with your actual values
resource_group_name  = "rg-siyuan-prod"
location             = "swedencentral"
project_name         = "azure-xiaoxi-siyuan"
storage_account_name = "stsiyuanprod001" # Must be globally unique
siyuan_auth_code     = "<YOUR_SIYUAN_AUTH_CODE>"
siyuan_api_token     = "<YOUR_STABLE_API_TOKEN>"
timezone             = "Europe/Stockholm"

# Container sizing
container_cpu    = 0.5
container_memory = "1Gi"
min_replicas     = 1
max_replicas     = 1

# Bootstrap
bootstrap_enabled = true

# Azure OpenAI / AI Foundry model
openai_model_name      = "gpt-4o-mini"
openai_deployment_name = "gpt-4o-mini-deployment"
openai_model_version   = "2024-07-18"

# Optional: override the OpenAI-compatible base URL and model for SiYuan
# openai_api_base_url = "https://<your-endpoint>.openai.azure.com/openai/deployments/<deployment>"
# openai_api_model    = "gpt-4o-mini"